{
  "name": "crontab-formatter",
  "displayName": "Crontab Formatter",
  "description": "%ext.description%",
  "version": "0.3.0",
  "publisher": "EvgeniiShapovalov",
  "icon": "images/cronformat.png",
  "author": "EvgeniiShapovalov (https://github.com/e-u-shapovalov)",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "crontab",
    "cron",
    "formatter",
    "align",
    "cron.d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/e-u-shapovalov/crontab-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/e-u-shapovalov/crontab-formatter/issues"
  },
  "homepage": "https://github.com/e-u-shapovalov/crontab-formatter/blob/main/README.md",
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:crontab",
    "onLanguage:cron"
  ],
  "contributes": {
    "languages": [
      {
        "id": "crontab",
        "aliases": [
          "Crontab",
          "crontab"
        ],
        "extensions": [
          ".crontab"
        ],
        "filenames": [
          "crontab",
          "crontab.tmp"
        ],
        "filenamePatterns": [
          "**/cron.d/*",
          "**/etc/crontab"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cron",
        "aliases": [
          "Cron",
          "cron"
        ],
        "extensions": [
          ".cron"
        ],
        "filenames": [
          "cron"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crontab",
        "scopeName": "source.crontab",
        "path": "./syntaxes/crontab.tmLanguage.json"
      },
      {
        "language": "cron",
        "scopeName": "source.crontab",
        "path": "./syntaxes/crontab.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "crontab.formatDocument",
        "title": "%cmd.formatDocument.title%"
      },
      {
        "command": "crontab.explainLine",
        "title": "%cmd.explainLine.title%"
      },
      {
        "command": "crontab.detectFormat",
        "title": "%cmd.detectFormat.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "crontab.formatDocument",
          "when": "resourceLangId == crontab || resourceLangId == cron"
        },
        {
          "command": "crontab.explainLine",
          "when": "resourceLangId == crontab || resourceLangId == cron"
        },
        {
          "command": "crontab.detectFormat",
          "when": "resourceLangId == crontab || resourceLangId == cron"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "crontabFormatter.mode": {
          "type": "string",
          "enum": [
            "auto",
            "user",
            "system"
          ],
          "enumDescriptions": [
            "%config.mode.enum.auto%",
            "%config.mode.enum.user%",
            "%config.mode.enum.system%"
          ],
          "default": "auto",
          "markdownDescription": "%config.mode.desc%"
        },
        "crontabFormatter.secondsField": {
          "type": "string",
          "enum": [
            "auto",
            "true",
            "false"
          ],
          "enumDescriptions": [
            "%config.secondsField.enum.auto%",
            "%config.secondsField.enum.true%",
            "%config.secondsField.enum.false%"
          ],
          "default": "auto",
          "markdownDescription": "%config.secondsField.desc%"
        },
        "crontabFormatter.yearField": {
          "type": "string",
          "enum": [
            "auto",
            "true",
            "false"
          ],
          "enumDescriptions": [
            "%config.yearField.enum.auto%",
            "%config.yearField.enum.true%",
            "%config.yearField.enum.false%"
          ],
          "default": "auto",
          "markdownDescription": "%config.yearField.desc%"
        },
        "crontabFormatter.alignComments": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.alignComments.desc%"
        },
        "crontabFormatter.alignRedirects": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.alignRedirects.desc%"
        },
        "crontabFormatter.alignEnvEquals": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.alignEnvEquals.desc%"
        },
        "crontabFormatter.insertHeader": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.insertHeader.desc%"
        },
        "crontabFormatter.preserveIndentation": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.preserveIndentation.desc%"
        },
        "crontabFormatter.minSpacesBetweenColumns": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "markdownDescription": "%config.minSpacesBetweenColumns.desc%"
        },
        "crontabFormatter.formatMacros": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.formatMacros.desc%"
        },
        "crontabFormatter.validateOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.validateOnSave.desc%"
        },
        "crontabFormatter.explainHover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.explainHover.desc%"
        },
        "crontabFormatter.locale": {
          "type": "string",
          "enum": [
            "auto",
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "%config.locale.enum.auto%",
            "%config.locale.enum.ru%",
            "%config.locale.enum.en%"
          ],
          "default": "ru",
          "markdownDescription": "%config.locale.desc%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npx vsce package --ignoreFile .vsce-pack-ignore"
  },
  "dependencies": {
    "cronstrue": "^2.59.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
